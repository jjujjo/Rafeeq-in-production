# Rafeeq in production: environment variables
# Copy this file to .env and replace the placeholders with your own values.
# .env is listed in .gitignore: never commit it and never paste keys into code, issues or chat.

# ------------------------------------------------------------------ Required
# OPENROUTER_API_KEY: the key for every model call (free models only).
# Where to get it: https://openrouter.ai/settings/keys -> "New key" (shown only once; copy it right away).
# Tip: give the key a small credit limit (e.g. $1) so a paid model can never drain your balance.
# Free models allow 50 requests a day; a one-time purchase of 10 credits
# (https://openrouter.ai/settings/credits) raises that to 1,000 a day.
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# ------------------------------------------------------------------ Required for the HTTP API (servers/rafeeq_api.py)
# Keys YOU invent for Rafeeq's own API (no website issues them). Comma-separated to allow several clients.
# Where to get them: generate random values, e.g.
#   uv run python -c "import secrets; print(secrets.token_urlsafe(24))"
# RAFEEQ_API_KEYS: for client apps that chat with Rafeeq (header X-API-Key on /v1/chat).
# RAFEEQ_OFFICER_KEYS: for licensing officers who approve or reject queued write actions. Must differ from the above.
RAFEEQ_API_KEYS=replace-with-a-random-client-key
RAFEEQ_OFFICER_KEYS=replace-with-a-different-random-officer-key

# ------------------------------------------------------------------ Optional
# HF_TOKEN: not used by Rafeeq; only for the program's Hugging Face labs. Leave empty.
# HF_TOKEN: a Hugging Face token, only needed for the Hugging Face MCP server or HF Inference Providers.
# Where to get it: https://huggingface.co/settings/tokens -> "Create new token" -> Fine-grained,
# tick "Make calls to Inference Providers".
HF_TOKEN=hf_your-hugging-face-token-here

# Models (no key needed): free models with tool calling, checked 2026-10-29.
# Free lists change every few weeks; if one disappears, pick another from
# https://openrouter.ai/models?max_price=0&supported_parameters=tools
AGENT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
AGENT_SMALL_MODEL=nvidia/nemotron-3.5-super-vl:free
AGENT_FALLBACKS=nvidia/nemotron-3.5-super-vl:free,google/gemma-4-31b-it:free
# AGENT_PROVIDER=openrouter
# AGENT_CACHE=1     # 0 = always call the model (1 replays identical requests from disk to save quota)
